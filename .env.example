# ══════════════════════════════════════════════════════════════════════════
# Nujum Al-Huda Institute Center — Variables d'environnement Docker Compose
# Domaine: nujumalhuda.com
# ══════════════════════════════════════════════════════════════════════════

# Application
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:GENERATE_WITH_php_artisan_key:generate

# Base de données PostgreSQL
DB_DATABASE=nujumalhuda
DB_USERNAME=nujumalhuda
DB_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Redis
REDIS_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Laravel Reverb
REVERB_APP_ID=nujumalhuda
REVERB_APP_KEY=CHANGE_ME_IN_PRODUCTION
REVERB_APP_SECRET=CHANGE_ME_IN_PRODUCTION

# Domaine (confirmé le 27/09/2026)
APP_URL=https://nujumalhuda.com
FRONTEND_URL=https://nujumalhuda.com
SESSION_DOMAIN=null

# Note: Le nom officiel est "Nujum Al-Huda Institute Center"
# mais le domaine est volontairement court: nujumalhuda.com

# Email (à configurer selon le fournisseur)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@nujumalhuda.com
MAIL_FROM_NAME="Nujum Al-Huda Institute"

# SMS Orange (wrapper existant)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_SENDER_NAME="NujumAlHuda"
ORANGE_SMS_SENDER_ADDRESS=

# Notifications push (VAPID). Sans ces clés, aucun push n'est déclaré envoyé.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@nujumalhuda.com

# MediaMTX
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_RTMP_URL=rtmp://localhost:1935
MEDIAMTX_HLS_URL=https://nujumalhuda.com/hls
MEDIAMTX_WHEP_URL=https://nujumalhuda.com/whep
MEDIAMTX_VOD_BASE_URL=https://nujumalhuda.com/storage/recordings
MEDIAMTX_WEBHOOK_SECRET=CHANGE_ME_IN_PRODUCTION

# Paiements (Phase 6)
WAVE_API_KEY=
WAVE_API_SECRET=
WAVE_WEBHOOK_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=

# Analytics (auto-hébergé, Phase 6)
PLAUSIBLE_DOMAIN=nujumalhuda.com
PLAUSIBLE_API_KEY=
